{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ],
      "default": "in"
    },
    "amount": {
      "type": "number"
    },
    "usdt_out": {
      "type": "number"
    },
    "note": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "group_id": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "type",
    "amount"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}